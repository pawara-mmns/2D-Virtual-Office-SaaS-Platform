{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "RAILPACK",
    "buildCommand": "pnpm --filter @virtual-office/realtime build"
  },
  "deploy": {
    "startCommand": "cd apps/realtime && exec node --env-file-if-exists=.env dist/apps/realtime/src/index.js",
    "healthcheckPath": "/ready",
    "healthcheckTimeout": 120,
    "numReplicas": 1,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 3,
    "overlapSeconds": 0,
    "drainingSeconds": 30
  }
}
