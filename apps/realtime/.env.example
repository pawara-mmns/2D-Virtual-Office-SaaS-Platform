# Copy to apps/realtime/.env (ignored). Use the existing development project.
# Deployment supplies NODE_ENV=production and HTTPS allowed frontend origins.
# /health is liveness; /ready additionally requires DB/Auth and voice availability.
# Railway: repository-root build context, /railway.json, RAILPACK_NODE_VERSION=24.
# Keep one authority; stop any previous/local authority before a manual replacement.
SUPABASE_URL=https://rofutnholbtdmxccrkbs.supabase.co
SUPABASE_PUBLISHABLE_KEY=
PORT=2567
# PORT above is a local default. Let Railway inject its PORT; do not copy 2567.
# Hosted allowlist: the exact stable Vercel HTTPS origin; no wildcards.
REALTIME_ALLOWED_ORIGINS=http://localhost:3000
# Optional voice. Server-only: never copy credentials to NEXT_PUBLIC_ variables.
# Obtain these from one LiveKit Cloud project. All three are required for voice.
# Run one voice authority per environment namespace; avoid overlapping restarts.
# The dev script sets NODE_ENV=development and isolates Cloud room inventory
# from production even if credentials are reused. Do not run a local production
# entry against the hosted project's Cloud credentials. Prefer separate projects.
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
# Production: exact HTTPS frontend origin(s), comma-separated; terminate WSS at a trusted proxy.
# Optional absolute path when starting outside apps/realtime, to the canonical asset:
# OFFICE_MAP_PATH=D:/Project/2D Virtual Office SaaS Platform/apps/web/public/office/studio.json
