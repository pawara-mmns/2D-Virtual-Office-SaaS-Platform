# Copy to apps/web/.env.local. Use the existing Supabase project.
# Development defaults below. Deployed beta: HTTPS public origins, email mode,
# verified sender; rebuild after public setting changes. See README readiness.
# Vercel: set public values at build time and APP_URL to the stable beta HTTPS origin.
# Never upload local .env files; enter values in the intended Vercel project scope.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_REALTIME_URL=http://localhost:2567
# Optional server-to-server origin; defaults to NEXT_PUBLIC_REALTIME_URL.
# HTTPS in deployed environments; loopback HTTP is allowed for local services.
# Vercel cannot reach your localhost/Railway private HTTP DNS: omit this setting
# to use NEXT_PUBLIC_REALTIME_URL, or set the same Railway public HTTPS origin.
REALTIME_INTERNAL_URL=http://localhost:2567

# Server-only invitation delivery. Never prefix these with NEXT_PUBLIC_.
# Exact trusted application origin; match Supabase Site URL for local Auth.
APP_URL=http://localhost:3000
# email (default), or link only for NODE_ENV=development/test. Production rejects link.
INVITATION_DELIVERY_MODE=email
RESEND_API_KEY=
# Server sender only; never the logged-in user's address. Restart after changing.
# Testing: onboarding@resend.dev (real delivery only to the Resend account email).
# Production: a plain sender address on your Resend-verified domain.
INVITATION_FROM_EMAIL=

# Separate platform administration; all values below are SERVER ONLY.
# Install the additive migration only on an isolated local DB for development.
# An approved hosted identity-only setup can use scripts/sql/platform-admin-hosted-identity.sql
# instead; do not push the larger tenant-enforcement migration as a login repair.
# Dedicated LOGIN granted platform_admin_runtime; never postgres/service_role.
# Use TLS with certificate verification for remote PostgreSQL connections.
# Hosted IPv4 session pooler: use sslmode=verify-full and sslrootcert pointing
# to certs/supabase-prod-ca-2021.crt (absolute path in this local setup).
PLATFORM_ADMIN_DATABASE_URL=
PLATFORM_ADMIN_ORIGIN=http://localhost:3000
# AES-256-GCM key: 64 hex characters, injected through your secret manager.
PLATFORM_ADMIN_MFA_KEY=
# Server Auth admin key, separate from ordinary request clients.
SUPABASE_SECRET_KEY=
# Optional server-only URL for self-hosted Auth administration.
SUPABASE_ADMIN_URL=
# Platform tenant-data source, separate from the administrator identity database.
# supabase (default): read-only hosted Data API/Auth Admin API, exact same project
# as NEXT_PUBLIC_SUPABASE_URL. Run pnpm admin:connect:data with CLI access.
# database: explicitly selected combined local development store only.
PLATFORM_DATA_MODE=supabase
PLATFORM_DATA_PROJECT_REF=
PLATFORM_DATA_SUPABASE_URL=
PLATFORM_DATA_SUPABASE_SECRET_KEY=
# Shared web/realtime operations key, at least 43 random characters.
PLATFORM_OPERATIONS_KEY=
# Optional dedicated server-only office editor credential for the same project
# as NEXT_PUBLIC_SUPABASE_URL. If omitted, the matching tenant-data server key
# above is reused. Never set a NEXT_PUBLIC variant of this secret.
OFFICE_DECORATION_SUPABASE_URL=
OFFICE_DECORATION_SUPABASE_SECRET_KEY=
